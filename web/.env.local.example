# Supabase Cloud — אותם ערכים בפיתוח מקומי וב-Netlify (Production)
# העתק לקובץ .env.local (לא נכנס ל-Git):
#   copy .env.local.example .env.local
#
# מקור הערכים: Supabase Dashboard → Project Settings → API
#   - Project URL      → NEXT_PUBLIC_SUPABASE_URL
#   - anon public key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# אין צורך ב-Supabase מקומי (Docker). פיתוח מקומי מתחבר לאותו פרויקט ענן כמו האתר החי.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# אופציונלי: יעד גיוס חודשי בש"ח — מציג "פער ליעד" בדשבורד
# NEXT_PUBLIC_MONTHLY_TARGET_ILS=50000
